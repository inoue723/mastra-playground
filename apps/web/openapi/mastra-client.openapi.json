{
  "openapi": "3.1.0",
  "info": {
    "title": "Mastra API",
    "version": "1.0.0",
    "description": "Mastra Server API"
  },
  "paths": {
    "/examples/echo": {
      "get": {
        "summary": "Echo a query parameter",
        "description": "Returns the validated message supplied in the query string.",
        "tags": ["Examples"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "echo": {
                      "type": "string"
                    }
                  },
                  "required": ["echo"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "message",
            "in": "query",
            "required": true,
            "description": "Query parameter: message",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ]
      },
      "servers": [
        {
          "url": "/"
        }
      ]
    }
  }
}
