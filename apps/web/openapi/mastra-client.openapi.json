  "paths": {
    "/examples/echo": {
      "get": {
        "summary": "Echo a query parameter",
        "description": "Returns the validated message supplied in the query string.",
        "tags": ["Examples"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "echo": {
                      "type": "string"
                    }
                  },
                  "required": ["echo"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "message",
            "in": "query",
            "required": true,
            "description": "Query parameter: message",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ]
      },
      "servers": [
        {
          "url": "/"
        }
      ]
    },
    "/custom/user-skills": {
      "get": {
        "summary": "List the caller’s skills",
        "description": "Returns the authenticated user’s skills, optionally filtered by status.",
        "tags": ["User Skills"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "userId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "instructions": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": ["active", "inactive"]
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "updatedAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "userId",
                      "name",
                      "slug",
                      "description",
                      "instructions",
                      "status",
                      "createdAt",
                      "updatedAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Query parameter: status",
            "schema": {
              "type": "string",
              "enum": ["active", "inactive"]
            }
          }
        ]
      },
      "post": {
        "summary": "Create a skill",
        "description": "Creates a new skill owned by the authenticated user.",
        "tags": ["User Skills"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
