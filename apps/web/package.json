{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:mastra-openapi": "node scripts/fetch-mastra-openapi.mjs",
    "generate:mastra-client": "pnpm generate:mastra-openapi && openapi-ts --input ./openapi/mastra-client.openapi.json --output ./src/lib/generated/mastra-api --client @hey-api/client-fetch && oxfmt --write openapi/mastra-client.openapi.json src/lib/generated/mastra-api",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node dist/server/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.87",
    "@clerk/tanstack-react-start": "^1.5.9",
    "@mastra/ai-sdk": "1.10.0",
    "@mastra/client-js": "1.42.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "ai": "7.0.84",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
